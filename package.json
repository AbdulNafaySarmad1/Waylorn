{
  "name": "waylorn",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "contracts:generate": "pnpm --filter @waylorn/contracts generate",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "build": "pnpm --filter @waylorn/web build",
    "dev": "pnpm --parallel --filter @waylorn/dev-fixtures --filter @waylorn/web dev",
    "e2e": "pnpm --filter @waylorn/web e2e"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "@next/eslint-plugin-next": "16.3.6"
  }
}
